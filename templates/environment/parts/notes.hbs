<section
  class="tab {{tabs.notes.cssClass}} {{tabs.notes.id}} dhca-section dhca-section--body dhca-tab-panel dhca-tab-panel--notes"
  data-tab="{{tabs.notes.id}}"
  data-group="{{tabs.notes.group}}"
>
  <div class="dhca-tab-panel__scroll">
    <section class="dhca-panel dhca-panel--notes">
      <h2 class="dhca-panel__title">{{localize tabs.notes.label}}</h2>
      {{formInput notes.field value=notes.value enriched=notes.enriched toggled=true}}
    </section>
  </div>
</section>
