<aside class="adversary-sidebar-sheet dhca-section dhca-section--footer dhca-footer{{#unless compact.hasFooter}} dhca-footer--hidden{{/unless}}" {{#unless compact.hasFooter}}hidden{{/unless}}>
  {{#if compact.hasFooter}}
  <div class="dhca-footer__inner">
  {{#if compact.showResourceBlock}}
    {{#if compact.hasTrackedResources}}
      <div class="dhca-footer__title">
        {{#if compact.resources.hitPoints.max}}
          <span>{{localize 'DAGGERHEART.GENERAL.HitPoints.short'}}{{#if compact.resources.stress.max}} &amp; {{localize 'DAGGERHEART.GENERAL.stress'}}{{/if}}</span>
        {{else}}
          <span>{{localize 'DAGGERHEART.GENERAL.stress'}}</span>
        {{/if}}
        {{#if @root.editable}}
          <button
            type="button"
            class="dhca-adversary-resource-groups__add"
            data-dhca-add-adversary-resource-group
            data-tooltip-text="{{localize 'DHCS.Labels.AddAdversaryResourceGroup'}}"
            aria-label="{{localize 'DHCS.Labels.AddAdversaryResourceGroup'}}"
          >
            <i class="fa-solid fa-plus" aria-hidden="true"></i>
          </button>
        {{/if}}
      </div>
    {{/if}}

    {{> 'modules/daggerheart-compact-sheets/templates/parts/thresholds.hbs'}}

    {{#if compact.useResourcePips}}
      <div class="dhca-adversary-resource-groups">
        {{#each compact.adversaryResourceGroups.groups as |resourceGroup|}}
          {{> 'modules/daggerheart-compact-sheets/templates/parts/adversary-resource-group.hbs'
            resourceGroup=resourceGroup
          }}
        {{/each}}
      </div>
    {{else}}
      <div class="dhca-resource-row dhca-resource-row--fallback">
        {{#if compact.resources.hitPoints.max}}
          <label class="dhca-resource-field">
            <span class="dhca-resource-row__label">{{localize 'DAGGERHEART.GENERAL.HitPoints.short'}}:</span>
            <input
              type="number"
              name="system.resources.hitPoints.value"
              value="{{compact.resources.hitPoints.value}}"
              min="0"
              max="{{compact.resources.hitPoints.max}}"
              data-allow-delta="true"
            />
            <span class="dhca-resource-field__max">{{compact.resources.hitPoints.max}}</span>
          </label>
        {{/if}}

        {{#if compact.resources.stress.max}}
          <label class="dhca-resource-field">
            <span class="dhca-resource-row__label">{{localize 'DAGGERHEART.GENERAL.stress'}}:</span>
            <input
              type="number"
              name="system.resources.stress.value"
              value="{{compact.resources.stress.value}}"
              min="0"
              max="{{compact.resources.stress.max}}"
              data-allow-delta="true"
            />
            <span class="dhca-resource-field__max">{{compact.resources.stress.max}}</span>
          </label>
        {{/if}}
      </div>
    {{/if}}

    {{#if (lt compact.criticalThreshold 20)}}
      <div class="dhca-footer__meta">
        <span>
          {{localize 'DAGGERHEART.GENERAL.criticalShort'}}: {{compact.criticalThreshold}}+
        </span>
      </div>
    {{/if}}

  {{/if}}

    {{> 'modules/daggerheart-compact-sheets/templates/parts/attribution.hbs'}}
  </div>
  {{/if}}
</aside>
