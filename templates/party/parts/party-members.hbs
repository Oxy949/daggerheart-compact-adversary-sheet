<section
  class="tab {{tabs.partyMembers.cssClass}} {{tabs.partyMembers.id}} dhca-section dhca-section--body dhca-tab-panel dhca-tab-panel--party-members"
  data-tab="{{tabs.partyMembers.id}}"
  data-group="{{tabs.partyMembers.group}}"
>
  <div class="dhca-tab-panel__scroll">
    <ul class="dhca-party__member-list{{#unless @root.showStats}} dhca-party__member-list--limited{{/unless}}">
      {{#each partyMembers as |member|}}
        <li class="dhca-party-member" data-uuid="{{member.uuid}}">
          <button
            type="button"
            class="dhca-party-member__portrait"
            data-action="openDocument"
            data-uuid="{{member.uuid}}"
            data-tooltip-text="{{localize 'DHCS.Labels.OpenMember' name=member.name}}"
          >
            <img src="{{member.img}}" alt="" />
          </button>

          <div class="dhca-party-member__content">
            <header class="dhca-party-member__header">
              <div class="dhca-party-member__identity">
                <button type="button" class="dhca-party-member__name" data-action="openDocument" data-uuid="{{member.uuid}}">
                  {{member.name}}
                </button>
                {{#if member.subtitle}}
                  <span class="dhca-party-member__subtitle">{{member.subtitle}}</span>
                {{/if}}
              </div>
              {{#if @root.editable}}
                <button
                  type="button"
                  class="dhca-party-member__remove"
                  data-action="deletePartyMember"
                  data-uuid="{{member.uuid}}"
                  data-tooltip-text="{{localize 'DHCS.Labels.RemoveMember' name=member.name}}"
                >
                  <i class="fa-solid fa-xmark"></i>
                </button>
              {{/if}}
            </header>

            {{#if @root.showStats}}
              <div class="dhca-party-member__stats">
                {{#if member.evasion includeZero=true}}
                  <span><strong>{{localize 'DAGGERHEART.GENERAL.evasion'}}:</strong> {{member.evasion}}</span>
                {{/if}}
                {{#if member.difficulty includeZero=true}}
                  <span><strong>{{localize 'DAGGERHEART.GENERAL.difficulty'}}:</strong> {{member.difficulty}}</span>
                {{/if}}
                {{#unless (or (eq member.type 'companion') (eq member.type 'npc'))}}
                  <span><strong>{{localize 'DHCS.Labels.Thresholds'}}:</strong> {{member.damageThresholds.major}}/{{member.damageThresholds.severe}}</span>
                {{/unless}}
              </div>

              {{#unless (or (eq member.type 'companion') (eq member.type 'adversary') (eq member.type 'npc'))}}
                <div class="dhca-party-resource dhca-party-resource--hope">
                  <span class="dhca-party-resource__label">{{localize 'DAGGERHEART.GENERAL.hope'}}</span>
                  <div class="dhca-party-resource__track">
                    {{#times member.resources.hope.max}}
                      <button
                        type="button"
                        class="dhca-party-resource__pip dhca-party-resource__pip--hope{{#if (gte member.resources.hope.value (add this 1))}} filled{{/if}}"
                        data-action="toggleHope"
                        data-actor-id="{{member.uuid}}"
                        data-value="{{add this 1}}"
                      >
                        <i class="{{#if (gte member.resources.hope.value (add this 1))}}fa-solid fa-diamond{{else}}fa-regular fa-circle{{/if}}"></i>
                      </button>
                    {{/times}}
                  </div>
                </div>
              {{/unless}}

              <div class="dhca-party-member__resource-grid">
                {{#unless (or (eq member.type 'companion') (eq member.type 'npc'))}}
                  <div class="dhca-party-resource">
                    <span class="dhca-party-resource__label">{{localize 'DAGGERHEART.GENERAL.HitPoints.short'}} {{member.resources.hitPoints.value}}/{{member.resources.hitPoints.max}}</span>
                    <div class="dhca-party-resource__track">
                      {{#times member.resources.hitPoints.max}}
                        <button
                          type="button"
                          class="dhca-party-resource__pip dhca-party-resource__pip--hp{{#if (gte member.resources.hitPoints.value (add this 1))}} filled{{/if}}"
                          data-action="toggleHitPoints"
                          data-actor-id="{{member.uuid}}"
                          data-value="{{add this 1}}"
                        ></button>
                      {{/times}}
                    </div>
                  </div>
                {{/unless}}

                {{#unless (eq member.type 'npc')}}
                  <div class="dhca-party-resource">
                    <span class="dhca-party-resource__label">{{localize 'DAGGERHEART.GENERAL.stress'}} {{member.resources.stress.value}}/{{member.resources.stress.max}}</span>
                    <div class="dhca-party-resource__track">
                      {{#times member.resources.stress.max}}
                        <button
                          type="button"
                          class="dhca-party-resource__pip dhca-party-resource__pip--stress{{#if (gte member.resources.stress.value (add this 1))}} filled{{/if}}"
                          data-action="toggleStress"
                          data-actor-id="{{member.uuid}}"
                          data-value="{{add this 1}}"
                        ></button>
                      {{/times}}
                    </div>
                  </div>
                {{/unless}}

                {{#if member.armorScore.max}}
                  <div class="dhca-party-resource">
                    <span class="dhca-party-resource__label">{{localize 'DAGGERHEART.GENERAL.armorSlots'}} {{member.armorScore.value}}/{{member.armorScore.max}}</span>
                    <div class="dhca-party-resource__track">
                      {{#times member.armorScore.max}}
                        <button
                          type="button"
                          class="dhca-party-resource__pip dhca-party-resource__pip--armor{{#if (gte member.armorScore.value (add this 1))}} filled{{/if}}"
                          data-action="toggleArmorSlot"
                          data-actor-id="{{member.uuid}}"
                          data-value="{{add this 1}}"
                        >
                          <i class="{{#if (gte member.armorScore.value (add this 1))}}fa-solid fa-shield{{else}}fa-solid fa-shield-halved{{/if}}"></i>
                        </button>
                      {{/times}}
                    </div>
                  </div>
                {{/if}}
              </div>

              {{#if member.traits}}
                <div class="dhca-party-member__traits">
                  {{#each member.traits as |trait|}}
                    <span><strong>{{trait.label}}</strong> {{numberFormat trait.value sign=true}}</span>
                  {{/each}}
                </div>
              {{/if}}

              {{#if member.weapons}}
                <div class="dhca-party-member__weapons">
                  {{#each member.weapons as |weapon|}}
                    <img src="{{weapon.img}}" alt="" data-tooltip-text="{{weapon.name}}" />
                  {{/each}}
                </div>
              {{/if}}
            {{/if}}
          </div>
        </li>
      {{/each}}
    </ul>

    {{#unless document.system.partyMembers.length}}
      <div class="dhca-party__empty">
        <i class="fa-solid fa-user-plus"></i>
        <span>{{localize 'DHCS.Labels.DropActorsHere'}}</span>
      </div>
    {{/unless}}
  </div>
</section>
